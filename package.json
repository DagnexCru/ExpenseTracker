{
  "name": "spendwise-workspace",
  "version": "1.0.0",
  "description": "Professional MERN Personal Expense Tracker",
  "private": true,
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run server\" \"npm run client\"",
    "start": "npm run dev",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm install && npm run install:server && npm run install:client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mern",
    "expense-tracker",
    "react",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "DagnexCru",
  "license": "ISC"
}
