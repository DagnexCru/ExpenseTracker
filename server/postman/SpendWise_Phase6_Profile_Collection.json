{
  "info": {
    "_postman_id": "spendwise-phase-6-profile-currency-collection",
    "name": "SpendWise - Phase 6 (User Profile & Currency Preferences)",
    "description": "Postman test suite for Phase 6 of SpendWise Expense Tracker covering authenticated profile retrieval, name editing, preferred currency selection, protected field defense, and multi-tenant isolation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Current User Profile (Authenticated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Retrieves the authenticated user profile (name, email, currency) without password hash."
      }
    },
    {
      "name": "2. Update Display Name",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alexander Hamilton\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Updates user display name. Enforces 2-50 characters length constraint."
      }
    },
    {
      "name": "3. Update Preferred Display Currency to USD",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Updates preferred display currency to USD. Whitelist verified against SUPPORTED_CURRENCY_CODES."
      }
    },
    {
      "name": "4. Update Both Name and Currency to Default ETB",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dagnew Cru\",\n  \"currency\": \"ETB\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Updates both display name and restores default currency preference to ETB."
      }
    },
    {
      "name": "5. Negative Validation: Empty Body (400 Bad Request)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Verifies that an empty update body is rejected with 400 Bad Request."
      }
    },
    {
      "name": "6. Negative Validation: Unsupported Currency (400 Bad Request)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currency\": \"BITCOIN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Verifies server returns 400 Bad Request when an unsupported currency is supplied."
      }
    },
    {
      "name": "7. Negative Validation: Attempt to Mutate Email (400 Bad Request)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"stolenaccount@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Verifies security guard prevents modification of protected field 'email'."
      }
    },
    {
      "name": "8. Negative Validation: Attempt to Inject Password Hash (400 Bad Request)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"InjectedPassword123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Verifies security guard blocks attempt to alter password via profile PATCH endpoint."
      }
    },
    {
      "name": "9. Negative Security: Unauthenticated Access (401 Unauthorized)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Verifies route guard returns 401 Unauthorized when no credentials or token are provided."
      }
    }
  ]
}
