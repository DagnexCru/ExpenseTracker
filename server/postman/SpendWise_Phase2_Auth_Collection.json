{
  "info": {
    "_postman_id": "spendwise-phase2-auth-suite",
    "name": "SpendWise API - Phase 2 Authentication",
    "description": "Automated Postman Collection testing SpendWise Phase 2 Authentication endpoints with HTTP-only cookies and bcrypt security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Register New User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dagnew Cru\",\n  \"email\": \"dagnew@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "02 - Login User",
      "request": {
        "method": "POST",
