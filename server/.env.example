# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/expensetracker

# Frontend URL (For CORS allowlist)
CLIENT_URL=http://localhost:5173

# Authentication Security (JWT & Cookies)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN_DAYS=7
